# docker-compose.prod.yml 용 환경변수. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 에 올리지 않음)
AUTH_TOKEN_SECRET=            # 32자 이상 랜덤 문자열 (openssl rand -base64 48)
CORS_ALLOWED_ORIGINS=https://your-client.vercel.app
DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
DATAGSM_REDIRECT_URI=https://your-server-domain/api/auth/datagsm/callback
OPENAI_API_KEY=               # 비우면 AI 리터치는 꺼짐(503)
OPENAI_MODEL=gpt-5.4-mini     # 4개 모델 비교 결과 품질 최고 (응답 5~8초)
OPENAI_REASONING_EFFORT=low   # gpt-5 계열만. gpt-4.1 계열이면 비울 것
PROXY_NETWORK=my-cloud_default
APP_HEAP=768m
DOCKER_MTU=1500             # 호스트 MTU 가 더 작으면 그 값으로 (ip link show)
ADMIN_IDS=                    # 관리자 DataGSM 계정 id (쉼표 구분, 이름은 겹칠 수 있어 id로). 관리자는 픽셀 무제한
